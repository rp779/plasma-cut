# Copy these into the Netlify UI: Site settings → Environment variables
# Never commit real keys.

# Preferred (Phase 2 / iOS-ready): Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Default web storage if Supabase is unset: GitHub Contents API
GITHUB_TOKEN=ghp_your_token_with_repo_contents_access
GITHUB_REPO=rp779/plasma-cut
